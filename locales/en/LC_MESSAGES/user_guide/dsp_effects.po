#: ../../source/user_guide/dsp_effects.rst:2 7cad9efd882642f58df32453e6e73e71
msgid "DSP 效果器"
msgstr "DSP effects"

#: ../../source/user_guide/dsp_effects.rst:4 a2d4614e0f80452a924d495eac23daf9
msgid "``FmodAudioEffect*`` 资源配置总线效果，``FmodDSP`` 提供低层 DSP 接口。相同总线上的声音依次经过其效果器槽位。"
msgstr ""
"``FmodAudioEffect*`` resources configure bus effects; ``FmodDSP`` provides the low-level DSP API."
" Sounds on a bus pass through its effect slots in order."

#: ../../source/user_guide/dsp_effects.rst:7 f28805899a284c06ad5ff32f00b0c236
msgid "选择效果器"
msgstr "Choose an effect"

#: ../../source/user_guide/dsp_effects.rst:12 cdd2c3b3f20343b2926df384b6dfa8d4
