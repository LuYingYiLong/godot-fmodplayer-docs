msgstr "``pitch``"

#: ../../source/user_guide/playback.rst:70 882a94846d9447ae95b2193598ecd769
msgid "音高和速度倍率；``1.0`` 是正常"
msgstr "Pitch and speed multiplier; ``1.0`` is normal."

#: ../../source/user_guide/playback.rst:71 a8abc5d763b0408ebfe7e02257335f18
