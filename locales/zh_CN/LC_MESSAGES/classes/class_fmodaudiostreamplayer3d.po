msgstr "返回当前播放速度和音高缩放"

#: ../../source/classes/class_fmodaudiostreamplayer3d.rst:779 ac96e4583d034d229f9d01ccc6e1ed94
msgid "\\ ``1.0`` is the default pitch, ``0.5`` is one octave lower, ``2.0`` is one octave higher."
msgstr "``1.0``    为默认音高，   ``0.5``    降低一个八度，   ``2.0``    升高一个八度。"

#: ../../source/classes/class_fmodaudiostreamplayer3d.rst:791 f9092a9536734cf2889180fa4da40016
msgid "Controls playback state. Setting to ``true`` starts playback from the beginning."
msgstr "控制播放状态。设置为  ``true``  会从头开始播放。"

#: ../../source/classes/class_fmodaudiostreamplayer3d.rst:793 36c279d9c4a741f9a17c2520e4565030
msgid "Setting to ``false`` stops playback."
msgstr "设为    ``false``    会停止播放。"

