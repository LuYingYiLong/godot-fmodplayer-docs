#: ../../source/classes/class_fmodaudioeffectamplify.rst:14 06d97408eae04013a600208e31eff5f4
msgid "A simple gain/volume effect for amplifying or attenuating audio signals."
msgstr "简单增益效果，用于放大或衰减信号。"

#: ../../source/classes/class_fmodaudioeffectamplify.rst:19 7beb45756fca44388412803918efaee2
msgid "Description"
