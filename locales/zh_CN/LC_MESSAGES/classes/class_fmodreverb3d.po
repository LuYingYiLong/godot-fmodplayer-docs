#: ../../source/classes/class_fmodreverb3d.rst:496 191d00241e364495b4e26eabbfc8f7ba
msgid "Enables or disables this reverb zone."
msgstr "启用或禁用该混响区域。"

#: ../../source/classes/class_fmodreverb3d.rst:498 be2b1808782c4513a587b68375428103
msgid "When inactive (``false``), the reverb does not contribute to the audio output."
msgstr "未激活（   ``false``   ）时不参与音频输出。"

#: ../../source/classes/class_fmodreverb3d.rst:500 dfdedcd07d3249099fe47122bc19ee3f
msgid "Use this to toggle reverb on/off without destroying and recreating it."
msgstr "可直接切换混响的启用状态，无需销毁并重新创建。"

