#: ../../source/classes/class_fmodchannelcontrol.rst:1324 ce49c043262d4381a9b9ee5596d958bf
msgid "``\"start\"`` (``int``): The DSP clock value when playback should start."
msgstr "``\"start\"``   （   ``int``   ）：开始播放时的 DSP 时钟值。"

#: ../../source/classes/class_fmodchannelcontrol.rst:1326 f78838cc9f624290930232886b419058
msgid "``\"end\"`` (``int``): The DSP clock value when playback should stop."
msgstr "``\"end\"``   （   ``int``   ）：停止播放时的 DSP 时钟值。"

#: ../../source/classes/class_fmodchannelcontrol.rst:1328 e56d5e20dded46978f440d512e7a9a99
msgid "``\"stop_channels\"`` (``bool``): Whether to stop channels when the end time is reached."
msgstr "``\"stop_channels\"``   （   ``bool``   ）：到达结束时间时是否停止通道。"

